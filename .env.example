# =============================================================================
# .env.example — DUMMY TEMPLATE ONLY. Copy to .env and fill in real values.
# Never commit .env. Never put real keys in code, logs, screenshots, or docs.
# =============================================================================

# --- Class services (dobolyi.com, ports 9001+; ask the team for details) -- -
# Ports below are placeholders — the team will confirm which port serves which
# service (vision LLM, text/visual embeddings, reranker, document parser).
BASE_URL_VISION=http://dobolyi.com:9001/v1
BASE_URL_TEXT_EMBED=http://dobolyi.com:9002/v1
BASE_URL_VISUAL_EMBED=http://dobolyi.com:9003/v1
BASE_URL_RERANK=http://dobolyi.com:9004/v1
BASE_URL_PARSE=http://dobolyi.com:9005/v1

CLASS_API_KEY=sk-dummy-key-replace-me
CLASS_API_KEY_RERANK=sk-dummy-key-replace-me

# --- Models --------------------------------------------------------------
# TEXT_EMBED_MODEL below is the model verified on the live service in M0
# (port 9002; 2048-dim output). Other model names are placeholders pending
# a team decision on what to document in this template.
# NOTE: port 9000 is reserved for Hermes agentic operations — never point
# any application service at it.
VISION_MODEL=replace-with-vision-model
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
VISUAL_EMBED_MODEL=replace-with-visual-embedding-model
RERANK_MODEL=replace-with-rerank-model

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=7860
